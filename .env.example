# Server Configuration
PORT=3333
LOG_LEVEL=debug

# Paths
PATH_MY_CALIBRE=/path/to/cache
PATH_BOOKS=/path/to/calibre/library

# Database
MONGO_URL=mongodb://localhost

# Authentication Configuration
AUTHENT_LENGTH=128
AUTHENT_DIGEST=sha512

# Session Secret (REQUIRED)
# Generate a strong random string for production
# Example: openssl rand -base64 32
SESSION_SECRET=change-me-to-a-random-secret

# JWT Authentication Secret (REQUIRED)
# Generate a strong random string for production
# Example: openssl rand -base64 32
AUTHENT_JWT_SECRET=change-me-to-a-random-jwt-secret

# Google OAuth (Optional - for Google authentication)
AUTHENT_GOOGLE_CLIENTID=your-google-client-id
AUTHENT_GOOGLE_CLIENTSECRET=your-google-client-secret
AUTHENT_GOOGLE_CALLBACKURL=https://localhost:4200/assets/logged.html

# Facebook OAuth (Optional - for Facebook authentication)
AUTHENT_FACEBOOK_CLIENTID=your-facebook-client-id
AUTHENT_FACEBOOK_CLIENTSECRET=your-facebook-client-secret
AUTHENT_FACEBOOK_CALLBACKURL=https://localhost:4200/assets/logged.html

# SMTP Configuration (for email notifications)
SMTP_ENCRYPTION=SSL
SMTP_PASSWORD=your-smtp-password
SMTP_PORT=465
SMTP_SERVER_NAME=smtp.gmail.com
SMTP_USER_NAME=your-email@gmail.com

