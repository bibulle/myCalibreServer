{
  "name": "my-calibre-server",
  "version": "0.11.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bibulle/myCalibreServer"
  },
  "author": {
    "name": "Bibulle"
  },
  "scripts": {
    "ng": "nx",
    "postinstall": "node ./decorate-angular-cli.js",
    "start": "nx serve frontend",
    "start:frontend": "nx serve frontend",
    "start:api": "nx serve api",
    "build": "nx build",
    "test": "nx test",
    "test:api": "nx test api",
    "test:frontend": "nx test frontend",
    "test:watch": "nx test --watch",
    "test:coverage": "nx test --coverage",
    "e2e": "./apps/frontend-e2e/scripts/run-e2e-tests.sh",
    "e2e:open": "./apps/frontend-e2e/scripts/run-e2e-tests.sh --open",
    "e2e:spec": "./apps/frontend-e2e/scripts/run-e2e-tests.sh --spec",
    "e2e:headless": "./apps/frontend-e2e/scripts/run-e2e-tests.sh --headless",
    "e2e:seed": "node apps/frontend-e2e/scripts/seed-test-db.js",
    "models": "sequelize-auto -o ./models -e=sqlite -d data/calibre/metadata.db",
    "release-patch": "npm run test:api && npm run test:frontend && npm run e2e:headless && standard-version --no-verify --commit-all --release-as patch",
    "release-minor": "npm run test:api && standard-version --no-verify --commit-all --release-as minor",
    "release-major": "npm run test:api && npm run test:frontend && npm run e2e:headless && standard-version --no-verify --commit-all --release-as major",
    "replace:version": "json -I -f libs/api-interfaces/src/lib/version.json -e \"this.version='`cat package.json | json version`'; this.github_url='`cat package.json | npx json repository.url`'; this.name='$npm_package_name'; this.copyright='2016-`date +%Y` `cat package.json | npx json author.name`'\" && git add libs/api-interfaces/src/lib/version.json"
  },
  "standard-version": {
    "scripts": {
      "postbump": "npm run replace:version"
    },
    "types": [
      {
        "type": "feat",
        "section": "Features"
      },
      {
        "type": "fix",
        "section": "Bug Fixes"
      },
      {
        "type": "refactor",
        "section": "Code Refactoring"
      },
      {
        "type": "perf",
        "section": "Performance Improvements"
      },
      {
        "type": "test",
        "section": "Tests"
      }
    ]
  },
  "private": true,
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "dependencies": {
    "@angular/animations": "21.2.9",
    "@angular/cdk": "21.2.9",
    "@angular/common": "21.2.9",
    "@angular/compiler": "21.2.9",
    "@angular/core": "21.2.9",
    "@angular/forms": "21.2.9",
    "@angular/material": "21.2.9",
    "@angular/platform-browser": "21.2.9",
    "@angular/platform-browser-dynamic": "21.2.9",
    "@angular/router": "21.2.9",
    "@angular/service-worker": "21.2.9",
    "@auth0/angular-jwt": "^5.1.2",
    "@nestjs/common": "^11.1.27",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.27",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.27",
    "@nestjs/schedule": "^6.1.3",
    "@ngx-translate/core": "^15.0.0",
    "@ngx-translate/http-loader": "^8.0.0",
    "@nx/angular": "23.0.1",
    "@rechat/squel": "^5.15.1",
    "async": "^3.2.4",
    "cron": "^4.4.0",
    "express-session": "^1.17.3",
    "jsonwebtoken": "^9.0.0",
    "mongodb": "^4.14.0",
    "nodemailer": "^6.9.1",
    "passport": "^0.6.0",
    "passport-facebook": "^3.0.0",
    "passport-google-id-token": "^0.4.7",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "passport-unique-token": "^3.0.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0",
    "sequelize": "^6.29.3",
    "sequelize-auto": "^0.8.8",
    "sharp": "^0.30.7",
    "sqlite3": "^5.1.6",
    "tslib": "^2.0.0",
    "zone.js": "0.16.2"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "21.2.9",
    "@angular-eslint/eslint-plugin": "21.4.0",
    "@angular-eslint/eslint-plugin-template": "21.4.0",
    "@angular-eslint/template-parser": "21.4.0",
    "@angular-devkit/core": "21.2.9",
    "@angular-devkit/schematics": "21.2.9",
    "@angular/cli": "21.2.18",
    "@angular/compiler-cli": "21.2.9",
    "@angular/language-service": "21.2.9",
    "@angular/pwa": "21.2.9",
    "@schematics/angular": "21.2.9",
    "@commitlint/config-conventional": "^17.4.4",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "^11.1.27",
    "@nx/eslint-plugin": "23.0.1",
    "@nx/cypress": "23.0.1",
    "@nx/jest": "23.0.1",
    "@nx/js": "23.0.1",
    "@nx/nest": "23.0.1",
    "@nx/node": "23.0.1",
    "@nx/webpack": "23.0.1",
    "@nx/workspace": "23.0.1",
    "@types/async": "^3.2.18",
    "@types/express-session": "^1.17.7",
    "@types/jest": "30.0.0",
    "@types/lodash": "^4.14.191",
    "@types/node": "^18.15.5",
    "@types/nodemailer": "^6.4.7",
    "@types/passport": "^1.0.12",
    "@types/sharp": "^0.30.5",
    "@types/sqlite3": "^3.1.8",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.11.0",
    "@typescript-eslint/parser": "^8.11.0",
    "commitlint": "^17.5.0",
    "cypress": "15.18.0",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-cypress": "^2.12.1",
    "jasmine-marbles": "^0.9.2",
    "jest": "30.4.2",
