{
  "name": "my-calibre-server",
  "version": "0.11.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bibulle/myCalibreServer"
  },
  "author": {
    "name": "Bibulle"
  },
  "scripts": {
    "ng": "nx",
    "postinstall": "node ./decorate-angular-cli.js",
    "start": "nx serve frontend",
    "start:frontend": "nx serve frontend",
    "start:api": "nx serve api",
    "build": "nx build",
    "test": "nx test",
    "test:api": "nx test api",
    "test:frontend": "nx test frontend",
    "test:watch": "nx test --watch",
    "test:coverage": "nx test --coverage",
    "e2e": "./apps/frontend-e2e/scripts/run-e2e-tests.sh",
    "e2e:open": "./apps/frontend-e2e/scripts/run-e2e-tests.sh --open",
    "e2e:spec": "./apps/frontend-e2e/scripts/run-e2e-tests.sh --spec",
    "e2e:headless": "./apps/frontend-e2e/scripts/run-e2e-tests.sh --headless",
    "e2e:seed": "node apps/frontend-e2e/scripts/seed-test-db.js",
    "models": "sequelize-auto -o ./models -e=sqlite -d data/calibre/metadata.db",
    "release-patch": "npm run test:api && npm run test:frontend && npm run e2e:headless && standard-version --no-verify --commit-all --release-as patch",
    "release-minor": "npm run test:api && standard-version --no-verify --commit-all --release-as minor",
    "release-major": "npm run test:api && npm run test:frontend && npm run e2e:headless && standard-version --no-verify --commit-all --release-as major",
    "replace:version": "json -I -f libs/api-interfaces/src/lib/version.json -e \"this.version='`cat package.json | json version`'; this.github_url='`cat package.json | npx json repository.url`'; this.name='$npm_package_name'; this.copyright='2016-`date +%Y` `cat package.json | npx json author.name`'\" && git add libs/api-interfaces/src/lib/version.json"
  },
  "standard-version": {
    "scripts": {
      "postbump": "npm run replace:version"
    },
    "types": [
      {
        "type": "feat",
        "section": "Features"
      },
      {
        "type": "fix",
        "section": "Bug Fixes"
      },
      {
        "type": "refactor",
        "section": "Code Refactoring"
      },
      {
        "type": "perf",
        "section": "Performance Improvements"
      },
      {
        "type": "test",
        "section": "Tests"
      }
    ]
  },
  "private": true,
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "dependencies": {
    "@angular/animations": "^18.2.0",
    "@angular/cdk": "^18.2.0",
    "@angular/common": "^18.2.0",
    "@angular/compiler": "^18.2.0",
    "@angular/core": "^18.2.0",
    "@angular/forms": "^18.2.0",
    "@angular/material": "^18.2.0",
    "@angular/platform-browser": "^18.2.0",
    "@angular/platform-browser-dynamic": "^18.2.0",
    "@angular/router": "^18.2.0",
    "@angular/service-worker": "^18.2.0",
    "@auth0/angular-jwt": "^5.1.2",
    "@nestjs/common": "^9.3.12",
    "@nestjs/config": "^2.3.1",
    "@nestjs/core": "^9.3.12",
    "@nestjs/passport": "^9.0.3",
    "@nestjs/platform-express": "^9.3.12",
    "@nestjs/schedule": "^2.2.0",
    "@ngx-translate/core": "^15.0.0",
    "@ngx-translate/http-loader": "^8.0.0",
    "@nx/angular": "^19.8.0",
    "@rechat/squel": "^5.15.1",
    "async": "^3.2.4",
    "cron": "^2.3.0",
    "crypto": "^1.0.1",
    "express-session": "^1.17.3",
    "jsonwebtoken": "^9.0.0",
    "mongodb": "^4.14.0",
    "nodemailer": "^6.9.1",
    "passport": "^0.6.0",
    "passport-facebook": "^3.0.0",
    "passport-google-id-token": "^0.4.7",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "passport-unique-token": "^3.0.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0",
    "rxjs-for-await": "^1.0.0",
    "sequelize": "^6.29.3",
    "sequelize-auto": "^0.8.8",
    "sharp": "^0.30.7",
    "sqlite3": "^5.1.6",
    "tslib": "^2.0.0",
    "zone.js": "^0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.0",
    "@angular-eslint/eslint-plugin": "^18.3.0",
    "@angular-eslint/eslint-plugin-template": "^18.3.0",
    "@angular-eslint/template-parser": "^18.3.0",
    "@angular/cli": "^18.2.0",
    "@angular/compiler-cli": "^18.2.0",
    "@angular/language-service": "^18.2.0",
    "@angular/pwa": "^18.2.0",
    "@commitlint/config-conventional": "^17.4.4",
    "@nestjs/schematics": "^9.0.4",
    "@nestjs/testing": "^9.3.12",
    "@nx/eslint-plugin": "^19.8.0",
    "@nx/cypress": "^19.8.0",
    "@nx/jest": "^19.8.0",
    "@nx/js": "^19.8.0",
    "@nx/nest": "^19.8.0",
    "@nx/node": "^19.8.0",
    "@nx/webpack": "^19.8.0",
    "@nx/workspace": "^19.8.0",
    "@types/async": "^3.2.18",
    "@types/cron": "^2.0.1",
    "@types/express-session": "^1.17.7",
    "@types/jest": "^28.1.8",
    "@types/lodash": "^4.14.191",
    "@types/node": "^18.15.5",
    "@types/nodemailer": "^6.4.7",
    "@types/passport": "^1.0.12",
    "@types/sharp": "^0.30.5",
    "@types/sqlite3": "^3.1.8",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.11.0",
    "@typescript-eslint/parser": "^8.11.0",
    "commitlint": "^17.5.0",
    "cypress": "^13.15.0",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-cypress": "^2.12.1",
    "jasmine-marbles": "^0.9.2",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-preset-angular": "^14.4.2",
    "json": "^11.0.0",
    "nx": "^19.8.0",
    "prettier": "^2.8.6",
    "standard-version": "^9.5.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.1",
    "typescript": "~5.5.4"
  }
}
