{
  "name": "my-calibre-server",
  "version": "0.12.15",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bibulle/myCalibreServer"
  },
  "author": {
    "name": "Bibulle"
  },
  "scripts": {
    "ng": "nx",
    "postinstall": "node ./decorate-angular-cli.js",
    "start": "nx serve frontend",
    "start:frontend": "nx serve frontend",
    "start:api": "nx serve api",
    "build": "nx build",
    "test": "nx run-many --target=test",
    "test:api": "nx test api",
    "test:frontend": "nx test frontend",
    "test:watch": "nx test --watch",
    "test:coverage": "nx run-many --target=test --coverage",
    "e2e": "playwright test --config=apps/frontend-e2e-playwright/playwright.config.ts",
    "e2e:playwright": "playwright test --config=apps/frontend-e2e-playwright/playwright.config.ts",
    "release-patch": "npm run test:api && npm run test:frontend && npm run e2e:playwright && standard-version --no-verify --commit-all --release-as patch",
    "release-minor": "npm run test:api && npm run test:frontend && npm run e2e:playwright && standard-version --no-verify --commit-all --release-as minor",
    "release-major": "npm run test:api && npm run test:frontend && npm run e2e:playwright && standard-version --no-verify --commit-all --release-as major",
    "replace:version": "json -I -f libs/api-interfaces/src/lib/version.json -e \"this.version='`cat package.json | json version`'; this.github_url='`cat package.json | npx json repository.url`'; this.name='$npm_package_name'; this.copyright='2016-`date +%Y` `cat package.json | npx json author.name`'\" && git add libs/api-interfaces/src/lib/version.json"
  },
  "standard-version": {
    "scripts": {
      "postbump": "npm run replace:version"
    },
    "bumpFiles": [
      "package.json",
      "package-lock.json",
      {
        "filename": "libs/api-interfaces/src/lib/version.json",
        "type": "json"
      }
    ],
    "types": [
      {
        "type": "feat",
        "section": "Features"
      },
      {
        "type": "fix",
        "section": "Bug Fixes"
      },
      {
        "type": "refactor",
        "section": "Code Refactoring"
      },
      {
        "type": "perf",
        "section": "Performance Improvements"
      },
      {
        "type": "test",
        "section": "Tests"
      }
    ]
  },
  "private": true,
  "overrides": {
    "multer": "2.1.1",
    "serialize-javascript": "7.0.4",
    "tar": "7.5.10",
    "ajv@^6": "6.14.0",
    "ajv@^8": "8.18.0",
    "minimatch": "10.2.4",
    "test-exclude": {
      "minimatch": "^3.1.2",
      "glob": {
        "minimatch": "^3.1.2"
      }
    },
    "@tootallnate/once": "3.0.1",
    "koa": "3.1.2"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "dependencies": {
    "@angular-devkit/core": "^21.2.1",
    "@angular/animations": "21.2.17",
    "@angular/cdk": "21.2.14",
    "@angular/common": "21.2.17",
    "@angular/compiler": "21.2.17",
    "@angular/core": "21.2.17",
    "@angular/forms": "21.2.17",
    "@angular/material": "21.2.14",
    "@angular/platform-browser": "21.2.17",
    "@angular/platform-browser-dynamic": "21.2.17",
    "@angular/router": "21.2.17",
    "@angular/service-worker": "21.2.17",
    "@auth0/angular-jwt": "^5.2.0",
    "@ngx-translate/core": "^18.0.0",
    "@ngx-translate/http-loader": "^18.0.0",
    "@nx/angular": "23.0.1",
    "@rechat/squel": "^5.15.1",
    "cron": "^3.5.0",
    "express-session": "^1.17.3",
    "google-auth-library": "^10.6.1",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^4.17.2",
    "nodemailer": "^8.0.11",
    "passport-custom": "^1.1.1",
    "passport-facebook": "^3.0.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "passport-unique-token": "^3.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "rxjs-for-await": "^1.0.0",
    "sharp": "^0.34.5",
    "sqlite3": "^5.1.7",
    "tslib": "^2.0.0",
    "zone.js": "0.16.2"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "21.2.18",
    "@angular/cli": "21.2.18",
    "@angular/compiler-cli": "21.2.17",
    "@angular/language-service": "21.2.17",
    "@angular/pwa": "21.2.18",
    "@commitlint/config-conventional": "^20.4.3",
    "@eslint/js": "^10.0.1",
    "@nestjs/common": "^11.1.27",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.27",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.27",
    "@nestjs/schedule": "^5.0.1",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "^11.1.27",
    "@nx/eslint-plugin": "23.0.1",
    "@nx/jest": "23.0.1",
    "@nx/js": "23.0.1",
    "@nx/nest": "23.0.1",
    "@nx/node": "23.0.1",
    "@nx/webpack": "23.0.1",
    "@nx/workspace": "23.0.1",
    "@playwright/test": "^1.61.1",
    "@types/express-session": "^1.17.7",
    "@types/jest": "30.0.0",
    "@types/lodash": "^4.14.191",
    "@types/node": "^24.13.2",
    "@types/nodemailer": "^7.0.11",
    "@types/passport": "^1.0.12",
    "@types/sqlite3": "^3.1.8",
    "@types/supertest": "^6.0.3",
    "angular-eslint": "21.4.0",
    "commitlint": "^20.4.3",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "jasmine-marbles": "^0.9.2",
    "jest": "30.4.2",
    "jest-environment-jsdom": "30.4.1",
    "jest-preset-angular": "17.0.0",
    "jest-util": "30.4.1",
    "json": "^11.0.0",
    "nx": "23.0.1",
    "passport": "^0.7.0",
    "prettier": "^3.9.4",
    "standard-version": "^9.5.0",
    "supertest": "^7.2.2",
    "ts-jest": "29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.62.1",
    "webpack": "5.108.4",
    "webpack-cli": "^7.0.0",
    "webpack-dev-server": "5.2.6"
  }
}
